# Perfil lan: HTTPS na rede confiável (ADR-0016; 08-deployment.md, "Perfil lan").
# Porta 80 não é publicada: sem redirect. Admin desligado.
{
	admin off
	auto_https disable_redirects
}

# CA local no volume caddy-data: tratar como segredo (SEC-08).
# HSTS só aqui (SEC-13). reverse_proxy grava X-Forwarded-For e X-Forwarded-Proto: https,
# descartando os do cliente (sem trusted_proxies).
{$SNOOK_LAN_HOST} {
	tls internal
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:8080
}
