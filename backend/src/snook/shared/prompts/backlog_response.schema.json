{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BacklogResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["epics"],
  "properties": {
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "user_stories"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "user_stories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "as_a",
                "i_want",
                "so_that",
                "priority",
                "story_points",
                "requested_by",
                "requested_at",
                "acceptance_criteria"
              ],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                "as_a": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "i_want": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "so_that": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "priority": { "type": "string", "enum": ["Low", "Medium", "High"] },
                "story_points": { "type": "integer", "enum": [1, 2, 3, 5, 8, 13] },
                "requested_by": { "type": ["string", "null"], "maxLength": 100 },
                "requested_at": { "type": "string", "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9]$" },
                "acceptance_criteria": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["given", "when", "then"],
                    "properties": {
                      "given": { "type": "string", "minLength": 1, "maxLength": 1000 },
                      "when": { "type": "string", "minLength": 1, "maxLength": 1000 },
                      "then": { "type": "string", "minLength": 1, "maxLength": 1000 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
