# cp .env.example .env e preencher. Nunca commitar o .env (SEC-08).

# cpu ou gpu. Para rede confiável, acrescente lan: cpu,lan ou gpu,lan.
COMPOSE_PROFILES=cpu

# Chave de cifra das chaves de LLM. Gerar com:
#   python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SNOOK_MASTER_KEY=
# Só durante a troca: chave-mestra anterior (README, "Chave-mestra").
# SNOOK_MASTER_KEY_PREVIOUS=

# Token do HuggingFace (aceite os termos do Pyannote com a mesma conta). Necessário na primeira execução.
HF_TOKEN=

# Interface e porta publicadas do frontend.
# SNOOK_BIND=127.0.0.1
# SNOOK_PORT=8080

# Obrigatório com o perfil lan: nome ou IP do servidor na rede.
# SNOOK_LAN_HOST=
